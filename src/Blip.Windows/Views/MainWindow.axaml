<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blip.Windows"
        x:Class="Blip.Windows.Views.MainWindow"
        Title="Blip" Width="1100" Height="760" MinWidth="720" MinHeight="480"
        Icon="/Assets/blip.ico" DragDrop.AllowDrop="True">

  <Window.Styles>
    <!-- bubbles: grey for them, blue for iMessage, green only for RCS -->
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource BubbleTheirs}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Border.bubble SelectableTextBlock.body">
      <Setter Property="Foreground" Value="{DynamicResource BubbleTheirsText}" />
    </Style>
    <Style Selector="Border.bubble.blue">
      <Setter Property="Background" Value="{StaticResource BlipBlue}" />
    </Style>
    <Style Selector="Border.bubble.green">
      <Setter Property="Background" Value="{StaticResource BlipGreen}" />
    </Style>
    <Style Selector="Border.bubble.blue SelectableTextBlock, Border.bubble.green SelectableTextBlock, Border.bubble.blue TextBlock, Border.bubble.green TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.bubble.pending">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="StackPanel.column">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="StackPanel.column.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="StackPanel.column.mine TextBlock.meta">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- avatar: photo when the Mac has one, else coloured initials -->
    <DataTemplate x:Key="Avatar">
      <Panel Width="40" Height="40">
        <Ellipse Fill="{Binding ColorBrush}" />
        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border CornerRadius="20" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
          <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
        </Border>
      </Panel>
    </DataTemplate>
  </Window.Resources>

  <Grid ColumnDefinitions="330,1,*">

    <!-- ============ sidebar ============ -->
    <DockPanel Grid.Column="0">
      <DockPanel DockPanel.Dock="Top" Margin="12,10,8,2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Classes="icon" ToolTip.Tip="New message" Click="OnNewMessage"><PathIcon Data="{StaticResource IconEdit}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Mark all as read" Command="{Binding MarkAllReadCommand}"><PathIcon Data="{StaticResource IconCheck}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}"><PathIcon Data="{StaticResource IconRefresh}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Settings" Click="OnSettings"><PathIcon Data="{StaticResource IconMore}" /></Button>
        </StackPanel>
        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusText}"
                 Fill="{Binding Status, Converter={x:Static local:StatusBrushConverter.Instance}}" />
        <TextBlock Text="Messages" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Opacity="0.6" FontSize="12" Margin="14,0,8,6" TextTrimming="CharacterEllipsis" />
      <DockPanel x:Name="NewMessagePanel" DockPanel.Dock="Top" Margin="10,2,10,6" IsVisible="False">
        <Button DockPanel.Dock="Right" Content="Go" Margin="6,0,0,0" Click="OnNewMessageGo" />
        <TextBox x:Name="NewRecipientBox" Text="{Binding NewRecipient}" Watermark="Phone number or email" KeyDown="OnNewRecipientKey" />
      </DockPanel>
      <TextBox DockPanel.Dock="Top" Margin="10,2,10,8" Text="{Binding Filter}" Watermark="Search conversations" />
      <ListBox Classes="sidebar" ItemsSource="{Binding VisibleConversations}" SelectedItem="{Binding Selected}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="12,Auto,*">
              <Ellipse Width="9" Height="9" Fill="{StaticResource BlipBlue}" VerticalAlignment="Center" IsVisible="{Binding IsUnread}" />
              <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Margin="2,0,10,0" />
              <StackPanel Grid.Column="2">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Opacity="0.6" FontSize="12" Margin="6,0,0,0" />
                  <TextBlock DockPanel.Dock="Right" Text="📌" FontSize="10" Margin="4,2,0,0" IsVisible="{Binding Pinned}" ToolTip.Tip="Pinned in Messages" />
                  <TextBlock DockPanel.Dock="Right" Text="🔕" FontSize="10" Margin="4,2,0,0" IsVisible="{Binding Muted}" ToolTip.Tip="Alerts hidden" />
                  <TextBlock local:EmojiText.Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock local:EmojiText.Text="{Binding Preview}" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Border Grid.Column="1" Background="{DynamicResource Hairline}" />

    <!-- ============ conversation ============ -->
    <DockPanel Grid.Column="2">
      <Border DockPanel.Dock="Top" Background="#33FF9F0A" Padding="12,8" IsVisible="{Binding HasBanner}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding DismissBannerCommand}"><PathIcon Data="{StaticResource IconClose}" /></Button>
          <SelectableTextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}"
              IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" DataContext="{Binding Selected}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,10,0" />
          <StackPanel VerticalAlignment="Center">
            <SelectableTextBlock local:EmojiText.Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <SelectableTextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="600" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- composer -->
      <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="This group is not sendable yet: the Mac has not listed its id." Opacity="0.7" Margin="4,0,0,6"
                   IsVisible="{Binding !CanCompose}" />
        <DockPanel Margin="0,0,0,6" IsVisible="{Binding HasReplyTarget}">
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CancelReplyCommand}"><PathIcon Data="{StaticResource IconClose}" /></Button>
          <TextBlock Opacity="0.7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
            <Run Text="Replying to: " /><Run Text="{Binding ReplyTarget.Text}" />
          </TextBlock>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding PendingFiles}" Margin="0,0,0,6">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="8" Padding="8,3" Margin="0,0,6,4" Background="{DynamicResource Chip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Converter={x:Static local:FileNameConverter.Instance}}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                  <Button Classes="icon" CommandParameter="{Binding}"
                          Command="{Binding $parent[ItemsControl].DataContext.RemovePendingFileCommand}"><PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" /></Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel IsEnabled="{Binding CanCompose}">
          <Button DockPanel.Dock="Left" Classes="icon" ToolTip.Tip="Attach a file" Click="OnAttach" VerticalAlignment="Bottom"><PathIcon Data="{StaticResource IconAttach}" /></Button>
          <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="Send (Enter)" Command="{Binding SendCommand}" VerticalAlignment="Bottom"
                  Foreground="{StaticResource BlipBlue}"><PathIcon Data="{StaticResource IconSend}" /></Button>
          <TextBox x:Name="Composer" Text="{Binding ComposerText}" Watermark="{Binding SendService}" AcceptsReturn="True"
                   TextWrapping="Wrap" MaxHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </DockPanel>
      </StackPanel>

      <Panel>
        <TextBlock Text="Pick a conversation" Opacity="0.4" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" />
        <ScrollViewer x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8">
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="12,2">
                  <TextBlock Text="{Binding DayHeader}" HorizontalAlignment="Center" Opacity="0.55" FontSize="12" Margin="0,12,0,6"
                             IsVisible="{Binding DayHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock local:EmojiText.Text="{Binding Sender}" Opacity="0.6" FontSize="12" Margin="14,4,0,1" IsVisible="{Binding ShowSender}" />
                  <StackPanel Classes="column" Classes.mine="{Binding IsMine}" MaxWidth="560">
                    <Border Classes="bubble" Classes.blue="{Binding IsBlue}" Classes.green="{Binding IsGreenBubble}" Classes.pending="{Binding Pending}">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy" Command="{Binding CopyCommand}" />
                          <MenuItem Header="Reply" Command="{Binding ReplyCommand}" IsVisible="{Binding RepliesEnabled}" />
                          <MenuItem Header="Tapback" IsVisible="{Binding TapbacksEnabled}">
                            <MenuItem Header="❤️ Love" Command="{Binding ReactCommand}" CommandParameter="love" />
                            <MenuItem Header="👍 Like" Command="{Binding ReactCommand}" CommandParameter="like" />
                            <MenuItem Header="👎 Dislike" Command="{Binding ReactCommand}" CommandParameter="dislike" />
                            <MenuItem Header="😂 Ha ha" Command="{Binding ReactCommand}" CommandParameter="laugh" />
                            <MenuItem Header="‼️ Emphasize" Command="{Binding ReactCommand}" CommandParameter="emphasize" />
                            <MenuItem Header="❓ Question" Command="{Binding ReactCommand}" CommandParameter="question" />
                          </MenuItem>
                        </ContextMenu>
                      </Border.ContextMenu>
                      <StackPanel>
                        <Border BorderThickness="3,0,0,0" BorderBrush="#80FFFFFF" Padding="8,2" Margin="0,2,0,6" Opacity="0.85" IsVisible="{Binding HasReply}">
                          <TextBlock local:EmojiText.Text="{Binding ReplyQuote}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,2">
                                <Button Command="{Binding OpenCommand}" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                        IsVisible="{Binding IsImage}" ToolTip.Tip="{Binding Name}">
                                  <Panel MinWidth="120" MinHeight="80">
                                    <TextBlock Text="{Binding Status}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Image Source="{Binding Image}" MaxWidth="320" MaxHeight="360" Stretch="Uniform" />
                                  </Panel>
                                </Button>
                                <Button Command="{Binding OpenCommand}" HorizontalAlignment="Left" Padding="10,6" Cursor="Hand" IsVisible="{Binding IsChip}">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.6" Margin="8,0,0,0" />
                                  </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7" IsVisible="{Binding IsChip}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Skia draws the colour emoji glyphs natively; selection and Ctrl+C work as in any text. -->
                        <SelectableTextBlock Classes="body" local:EmojiText.Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                             IsVisible="{Binding HasText}" ContextFlyout="{x:Null}" />
                        <TextBlock Text="unsent a message" FontStyle="Italic" Opacity="0.6" IsVisible="{Binding IsRetracted}" />
                        <HyperlinkButton Content="{Binding LinkTitle}" Command="{Binding OpenLinkCommand}" IsVisible="{Binding HasLink}"
                                         Padding="0" Margin="0,4,0,0" FontSize="12" />
                      </StackPanel>
                    </Border>
                    <Border HorizontalAlignment="Right" CornerRadius="10" Padding="6,1" Margin="0,-6,4,0" Background="{DynamicResource Chip}"
                            IsVisible="{Binding HasTapbacks}">
                      <TextBlock local:EmojiText.Text="{Binding Tapbacks}" FontSize="12" />
                    </Border>
                    <TextBlock Classes="meta" Text="{Binding Meta}" FontSize="11" Opacity="0.5" Margin="8,1" />
                    <TextBlock Text="Sending…" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" Margin="8,0" IsVisible="{Binding Pending}" />
                    <TextBlock Text="{Binding Receipt}" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" Margin="8,0" IsVisible="{Binding HasReceipt}" />
                    <TextBlock Text="{Binding Failure}" FontSize="11" Foreground="#FF453A" HorizontalAlignment="Right" Margin="8,0" TextWrapping="Wrap"
                               IsVisible="{Binding HasFailure}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2" MinHeight="2" IsVisible="{Binding IsLoadingThread}" />
      </Panel>
    </DockPanel>
  </Grid>
</Window>
