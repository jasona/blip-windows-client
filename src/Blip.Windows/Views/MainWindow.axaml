<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blip.Windows"
        x:Class="Blip.Windows.Views.MainWindow"
        Title="Blip" Width="1120" Height="760" MinWidth="760" MinHeight="500"
        Icon="/Assets/blip.ico" DragDrop.AllowDrop="True"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="52">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding $parent[Window].NewMessageCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding $parent[Window].FocusSearchCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- ============ surfaces ============ -->
    <Style Selector="Panel#Root">
      <Setter Property="Background" Value="{DynamicResource WindowSolid}" />
    </Style>
    <Style Selector="Panel#Root.mica">
      <Setter Property="Background" Value="{DynamicResource WindowMicaTint}" />
    </Style>

    <!-- ============ conversation list ============ -->
    <Style Selector="ListBox.sidebar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,0,8,8" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem">
      <Setter Property="Padding" Value="8,0,10,0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHover}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BlipBlue}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected TextBlock.secondary">
      <Setter Property="Foreground" Value="#D0FFFFFF" />
    </Style>
    <Style Selector="Ellipse.unread">
      <Setter Property="Fill" Value="{DynamicResource BlipBlue}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected Ellipse.unread">
      <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="Grid.row.unread TextBlock.name">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Grid.row.unread TextBlock.preview">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- ============ thread ============ -->
    <Style Selector="StackPanel.msg">
      <Setter Property="Margin" Value="20,1,20,1" />
    </Style>
    <Style Selector="StackPanel.msg.start">
      <Setter Property="Margin" Value="20,10,20,1" />
    </Style>
    <Style Selector="StackPanel.column">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="StackPanel.column > :is(Control)">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="StackPanel.column.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="StackPanel.column.mine > :is(Control)">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- bubbles: grey for them, blue for iMessage, green only for RCS -->
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource BubbleTheirs}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="12,7,12,8" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Border.bubble.tail">
      <Setter Property="CornerRadius" Value="18,18,18,6" />
    </Style>
    <Style Selector="Border.bubble.tail.mine">
      <Setter Property="CornerRadius" Value="18,18,6,18" />
    </Style>
    <Style Selector="Border.bubble SelectableTextBlock.body">
      <Setter Property="Foreground" Value="{DynamicResource BubbleTheirsText}" />
      <Setter Property="SelectionBrush" Value="#660A84FF" />
    </Style>
    <Style Selector="Border.bubble.blue">
      <Setter Property="Background" Value="{DynamicResource BlipBlue}" />
    </Style>
    <Style Selector="Border.bubble.green">
      <Setter Property="Background" Value="{DynamicResource BlipGreen}" />
    </Style>
    <Style Selector="Border.bubble.blue SelectableTextBlock, Border.bubble.green SelectableTextBlock, Border.bubble.blue TextBlock, Border.bubble.green TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.bubble.blue SelectableTextBlock.body, Border.bubble.green SelectableTextBlock.body">
      <Setter Property="SelectionBrush" Value="#59FFFFFF" />
    </Style>
    <Style Selector="Panel.bubblewrap.pending">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Panel.bubblewrap.tapped">
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>

    <!-- the tail: same colour as its bubble, tucked under the bottom corner -->
    <Style Selector="Path.tail">
      <Setter Property="Fill" Value="{DynamicResource BubbleTheirs}" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-9,0,0,0" />
      <Setter Property="RenderTransform" Value="scaleX(-1)" />
    </Style>
    <Style Selector="Path.tail.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,-9,0" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Path.tail.blue">
      <Setter Property="Fill" Value="{DynamicResource BlipBlue}" />
    </Style>
    <Style Selector="Path.tail.green">
      <Setter Property="Fill" Value="{DynamicResource BlipGreen}" />
    </Style>

    <!-- tapbacks sit on the bubble's top corner, as in Messages -->
    <Style Selector="Border.tapback">
      <Setter Property="Background" Value="{DynamicResource BubbleTheirs}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pane}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,-16,-10,0" />
    </Style>
    <Style Selector="Border.tapback.mine">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-10,-16,0,0" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
      <Setter Property="Margin" Value="6,3,6,0" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <!-- attachments -->
    <Style Selector="Button.plain">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.plain:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.plain:pointerover">
      <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.filechip">
      <Setter Property="Background" Value="{DynamicResource BubbleTheirs}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- composer -->
    <Style Selector="Button.send">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource BlipBlue}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.send.green">
      <Setter Property="Background" Value="{DynamicResource BlipGreen}" />
    </Style>
    <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BlipBlue}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.send.green:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BlipGreen}" />
    </Style>
    <Style Selector="Button.send:pressed">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource Chip}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4,4,4" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Avatar, drawn at 44 and scaled: photo when the Mac has one, else initials on a soft gradient. -->
    <DataTemplate x:Key="Avatar">
      <Viewbox>
        <Panel Width="44" Height="44">
          <Ellipse Fill="{Binding AvatarBrush}" />
          <TextBlock Text="{Binding Initials}" IsVisible="{Binding HasInitials}" Foreground="White" FontWeight="SemiBold" FontSize="17"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <PathIcon Data="{StaticResource IconPerson}" IsVisible="{Binding !HasInitials}" Foreground="White" Width="22" Height="22" />
          <Border CornerRadius="22" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
          </Border>
        </Panel>
      </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="SenderAvatar">
      <Viewbox>
        <Panel Width="44" Height="44">
          <Ellipse Fill="{Binding SenderBrush}" />
          <TextBlock Text="{Binding SenderInitials}" IsVisible="{Binding SenderHasInitials}" Foreground="White" FontWeight="SemiBold" FontSize="18"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <PathIcon Data="{StaticResource IconPerson}" IsVisible="{Binding !SenderHasInitials}" Foreground="White" Width="22" Height="22" />
        </Panel>
      </Viewbox>
    </DataTemplate>
  </Window.Resources>

  <Panel x:Name="Root">
    <Grid ColumnDefinitions="320,*" Margin="{Binding $parent[Window].OffScreenMargin}">

      <!-- ============ sidebar ============ -->
      <DockPanel Grid.Column="0">
        <!-- doubles as the title bar: drag to move, double-click to maximise -->
        <Grid DockPanel.Dock="Top" Height="52" ColumnDefinitions="*,Auto" Background="Transparent" Margin="18,0,10,0"
              PointerPressed="OnDragArea" DoubleTapped="OnDragAreaDoubleTapped">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="Messages" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border IsVisible="{Binding !IsOnline}" Background="{DynamicResource Chip}" CornerRadius="9" Padding="7,2,8,2"
                    VerticalAlignment="Center" ToolTip.Tip="{Binding StatusText}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{Binding Status, Converter={x:Static local:StatusBrushConverter.Instance}}" />
                <TextBlock Text="{Binding StatusShort}" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
            <Button Classes="icon" ToolTip.Tip="New message" Click="OnNewMessage"><PathIcon Data="{StaticResource IconCompose}" /></Button>
            <Button Classes="icon" ToolTip.Tip="More">
              <PathIcon Data="{StaticResource IconMore}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Mark All as Read" Command="{Binding MarkAllReadCommand}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Refresh" Command="{Binding RefreshCommand}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Settings…" Click="OnSettings">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Classes="pill filled" Margin="14,0,14,8" Height="32" Padding="10,0">
          <DockPanel>
            <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="0,0,8,0"
                      Foreground="{DynamicResource TextTertiary}" />
            <TextBox x:Name="SearchBox" Classes="bare" Text="{Binding Filter}" Watermark="Search" />
          </DockPanel>
        </Border>

        <Border x:Name="NewMessagePanel" DockPanel.Dock="Top" Classes="pill filled" Margin="14,0,14,8" Height="32" Padding="10,0,3,0"
                IsVisible="False">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="To:" Classes="secondary" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Classes="send" Width="26" Height="26" ToolTip.Tip="Start conversation" Click="OnNewMessageGo">
              <PathIcon Data="{StaticResource IconSendUp}" Width="12" Height="12" />
            </Button>
            <TextBox x:Name="NewRecipientBox" Classes="bare" Text="{Binding NewRecipient}" Watermark="Phone number or email"
                     KeyDown="OnNewRecipientKey" />
          </DockPanel>
        </Border>

        <ListBox Classes="sidebar" ItemsSource="{Binding VisibleConversations}" SelectedItem="{Binding Selected}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Classes="row" Classes.unread="{Binding IsUnread}" ColumnDefinitions="14,Auto,*" Height="68">
                <Ellipse Classes="unread" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                         IsVisible="{Binding IsUnread}" />
                <ContentControl Grid.Column="1" Width="46" Height="46" Content="{Binding}" ContentTemplate="{StaticResource Avatar}"
                                Margin="0,0,12,0" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Classes="secondary" FontSize="12" Margin="8,1,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="🔕" FontSize="10" Margin="4,2,0,0" IsVisible="{Binding Muted}" ToolTip.Tip="Alerts hidden" />
                    <TextBlock DockPanel.Dock="Right" Text="📌" FontSize="10" Margin="4,2,0,0" IsVisible="{Binding Pinned}" ToolTip.Tip="Pinned in Messages" />
                    <TextBlock Classes="name" local:EmojiText.Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock Classes="secondary preview" local:EmojiText.Text="{Binding Preview}" FontSize="13" LineHeight="17"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- ============ conversation ============ -->
      <Border Grid.Column="1" Background="{DynamicResource Pane}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource Banner}" Padding="16,8,8,8" IsVisible="{Binding HasBanner}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="icon small" Command="{Binding DismissBannerCommand}" VerticalAlignment="Top">
                <PathIcon Data="{StaticResource IconClose}" />
              </Button>
              <SelectableTextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
            </DockPanel>
          </Border>

          <!-- header; also part of the title bar -->
          <Border x:Name="ThreadHeader" DockPanel.Dock="Top" Height="60" Padding="20,0,20,0" Background="Transparent"
                  BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}"
                  PointerPressed="OnDragArea" DoubleTapped="OnDragAreaDoubleTapped"
                  IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" DataContext="{Binding Selected}" VerticalAlignment="Center" Spacing="12">
              <ContentControl Width="36" Height="36" Content="{Binding}" ContentTemplate="{StaticResource Avatar}" />
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock local:EmojiText.Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="520"
                           IsVisible="{Binding HasSubtitle}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- composer -->
          <StackPanel DockPanel.Dock="Bottom" Margin="14,6,18,16" Spacing="6"
                      IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="This group can't be sent to yet: the Mac hasn't listed its id." Classes="secondary" FontSize="12"
                       HorizontalAlignment="Center" IsVisible="{Binding !CanCompose}" />
            <Border Classes="chip" Margin="46,0,0,0" HorizontalAlignment="Left" IsVisible="{Binding HasReplyTarget}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconReply}" Width="12" Height="12" Foreground="{DynamicResource BlipBlue}" />
                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center">
                  <Run Text="Replying to " Foreground="{DynamicResource TextSecondary}" /><Run Text="{Binding ReplyTarget.Text}" />
                </TextBlock>
                <Button Classes="icon small" Command="{Binding CancelReplyCommand}" ToolTip.Tip="Cancel reply">
                  <PathIcon Data="{StaticResource IconClose}" />
                </Button>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding PendingFiles}" Margin="46,0,0,0" IsVisible="{Binding HasPendingFiles}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="chip" Margin="0,0,6,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconDocument}" Width="14" Height="14" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="{Binding Converter={x:Static local:FileNameConverter.Instance}}" FontSize="12" VerticalAlignment="Center"
                                 MaxWidth="220" TextTrimming="CharacterEllipsis" />
                      <Button Classes="icon small" CommandParameter="{Binding}" ToolTip.Tip="Remove"
                              Command="{Binding $parent[ItemsControl].DataContext.RemovePendingFileCommand}">
                        <PathIcon Data="{StaticResource IconClose}" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel IsEnabled="{Binding CanCompose}">
              <Button DockPanel.Dock="Left" Classes="icon" ToolTip.Tip="Attach a file" Click="OnAttach" VerticalAlignment="Bottom"
                      Margin="0,0,10,2">
                <PathIcon Data="{StaticResource IconAdd}" Width="22" Height="22" />
              </Button>
              <Border Classes="pill" MinHeight="36" Padding="14,0,4,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="send" Classes.green="{Binding SendsGreen}" ToolTip.Tip="Send (Enter)"
                          Command="{Binding SendCommand}" IsVisible="{Binding HasDraft}" VerticalAlignment="Bottom" Margin="6,0,0,3">
                    <PathIcon Data="{StaticResource IconSendUp}" Width="14" Height="14" />
                  </Button>
                  <TextBox x:Name="Composer" Classes="bare" Text="{Binding ComposerText}" Watermark="{Binding ComposerHint}"
                           AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" Padding="0,8" FontSize="14"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
              </Border>
            </DockPanel>
          </StackPanel>

          <Panel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                        IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}">
              <PathIcon Data="{StaticResource IconChats}" Width="52" Height="52" Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,8" />
              <TextBlock Text="No conversation selected" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Text="Pick one on the left, or press Ctrl+N to start a new one." Classes="tertiary" FontSize="13"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <!-- No Padding on this ScrollViewer: Avalonia leaves it out of the extent, which hid the
                 newest bubble's last 16 px (its receipt line) under the composer. Margin the items instead. -->
            <ScrollViewer x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Messages}" Margin="0,6,0,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Classes="msg" Classes.start="{Binding GroupStart}">
                      <TextBlock Classes="header" Text="{Binding DayHeader}"
                                 IsVisible="{Binding DayHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock local:EmojiText.Text="{Binding Sender}" Classes="secondary" FontSize="11" Margin="50,0,0,3"
                                 IsVisible="{Binding ShowSender}" />
                      <Grid ColumnDefinitions="Auto,*">
                        <!-- group chats: the sender's face beside the last bubble of their run -->
                        <Panel Width="36" IsVisible="{Binding HasGroupGutter}" VerticalAlignment="Bottom">
                          <ContentControl Width="28" Height="28" HorizontalAlignment="Left" Content="{Binding}"
                                          ContentTemplate="{StaticResource SenderAvatar}" IsVisible="{Binding ShowGroupAvatar}"
                                          ToolTip.Tip="{Binding Sender}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Classes="column" Classes.mine="{Binding IsMine}" MaxWidth="540" Spacing="2">
                          <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Margin="0,1" Spacing="2">
                                  <Button Classes="plain" Command="{Binding OpenCommand}" IsVisible="{Binding IsImage}" ToolTip.Tip="{Binding Name}">
                                    <Panel>
                                      <Border Width="220" Height="150" CornerRadius="16" Background="{DynamicResource Chip}"
                                              IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                          <PathIcon Data="{StaticResource IconDocument}" Width="22" Height="22" Foreground="{DynamicResource TextTertiary}" />
                                          <TextBlock Text="{Binding Status}" Classes="tertiary" FontSize="12" HorizontalAlignment="Center" />
                                        </StackPanel>
                                      </Border>
                                      <Border CornerRadius="16" ClipToBounds="True"
                                              IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Source="{Binding Image}" MaxWidth="300" MaxHeight="340" Stretch="Uniform" />
                                      </Border>
                                    </Panel>
                                  </Button>
                                  <Button Classes="filechip" Command="{Binding OpenCommand}" IsVisible="{Binding IsChip}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                      <TextBlock Text="{Binding Glyph}" FontSize="20" VerticalAlignment="Center" />
                                      <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" MaxWidth="240" TextTrimming="CharacterEllipsis" FontSize="13"
                                                   Foreground="{DynamicResource BubbleTheirsText}" />
                                        <TextBlock Text="{Binding Detail}" Classes="secondary" FontSize="11" />
                                      </StackPanel>
                                    </StackPanel>
                                  </Button>
                                  <TextBlock Text="{Binding Status}" Classes="caption" IsVisible="{Binding IsChip}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <Panel Classes="bubblewrap" Classes.pending="{Binding Pending}" Classes.tapped="{Binding HasTapbacks}"
                                 IsVisible="{Binding HasBubble}" ToolTip.Tip="{Binding TimeTip}" ToolTip.Placement="Left"
                                 ToolTip.ShowDelay="600">
                            <Path Classes="tail" Classes.mine="{Binding IsMine}" Classes.blue="{Binding IsBlue}" Classes.green="{Binding IsGreenBubble}"
                                  Data="{StaticResource BubbleTail}" IsVisible="{Binding ShowTail}" />
                            <Border Classes="bubble" Classes.tail="{Binding ShowTail}" Classes.mine="{Binding IsMine}"
                                    Classes.blue="{Binding IsBlue}" Classes.green="{Binding IsGreenBubble}">
                              <Border.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Copy" Command="{Binding CopyCommand}" />
                                  <MenuItem Header="Reply" Command="{Binding ReplyCommand}" IsVisible="{Binding RepliesEnabled}" />
                                  <MenuItem Header="Tapback" IsVisible="{Binding TapbacksEnabled}">
                                    <MenuItem Header="❤️ Love" Command="{Binding ReactCommand}" CommandParameter="love" />
                                    <MenuItem Header="👍 Like" Command="{Binding ReactCommand}" CommandParameter="like" />
                                    <MenuItem Header="👎 Dislike" Command="{Binding ReactCommand}" CommandParameter="dislike" />
                                    <MenuItem Header="😂 Ha ha" Command="{Binding ReactCommand}" CommandParameter="laugh" />
                                    <MenuItem Header="‼️ Emphasize" Command="{Binding ReactCommand}" CommandParameter="emphasize" />
                                    <MenuItem Header="❓ Question" Command="{Binding ReactCommand}" CommandParameter="question" />
                                  </MenuItem>
                                </ContextMenu>
                              </Border.ContextMenu>
                              <StackPanel>
                                <Border BorderThickness="2,0,0,0" BorderBrush="#99FFFFFF" Padding="8,1" Margin="0,3,0,6" Opacity="0.8"
                                        IsVisible="{Binding HasReply}">
                                  <TextBlock local:EmojiText.Text="{Binding ReplyQuote}" FontSize="12" TextTrimming="CharacterEllipsis"
                                             MaxHeight="34" TextWrapping="Wrap" />
                                </Border>
                                <!-- Skia draws the colour emoji glyphs natively; selection and Ctrl+C work as in any text. -->
                                <SelectableTextBlock Classes="body" local:EmojiText.Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                                     LineHeight="19" IsVisible="{Binding HasText}" ContextFlyout="{x:Null}" />
                                <TextBlock Text="unsent a message" FontStyle="Italic" Opacity="0.65" IsVisible="{Binding IsRetracted}" />
                                <HyperlinkButton Content="{Binding LinkTitle}" Command="{Binding OpenLinkCommand}" IsVisible="{Binding HasLink}"
                                                 Padding="0" Margin="0,4,0,0" FontSize="12" />
                              </StackPanel>
                            </Border>
                            <Border Classes="tapback" Classes.mine="{Binding IsMine}" IsVisible="{Binding HasTapbacks}">
                              <TextBlock local:EmojiText.Text="{Binding Tapbacks}" FontSize="14" />
                            </Border>
                          </Panel>

                          <TextBlock Classes="caption" Text="{Binding Extra}" IsVisible="{Binding HasExtra}" />
                          <TextBlock Classes="caption" Text="{Binding Receipt}" IsVisible="{Binding HasReceipt}" FontWeight="Medium" />
                          <StackPanel Orientation="Horizontal" Spacing="5" Margin="6,3,6,0" IsVisible="{Binding HasFailure}">
                            <PathIcon Data="{StaticResource IconError}" Width="13" Height="13" Foreground="#FF453A" />
                            <TextBlock Text="{Binding Failure}" FontSize="11" Foreground="#FF453A" TextWrapping="Wrap" MaxWidth="420" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2" MinHeight="2" IsVisible="{Binding IsLoadingThread}"
                         Foreground="{DynamicResource BlipBlue}" Background="Transparent" />
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </Panel>
</Window>
