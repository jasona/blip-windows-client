<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Blip.Windows.Views.SettingsWindow"
        Title="Blip settings" Width="640" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/blip.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="860">
    <StackPanel Margin="20">
      <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.8" IsVisible="False"
                 Text="Blip talks to the Mac that runs your iMessage bridge over SSH, with a key that can only run the bridge tools. Three steps: name the Mac, create the key, enroll it on the Mac." />

      <TextBlock Text="1. Your Mac" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,6" />
      <Grid ColumnDefinitions="*,90">
        <StackPanel>
          <TextBlock Text="user@host (as you would ssh to it)" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Host}" Margin="0,2,8,0" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Port" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Port}" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>

      <TextBlock Text="2. Key" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6" />
      <TextBlock Text="Private key file (a dedicated ed25519 key, not your everyday one)" Opacity="0.7" FontSize="12" />
      <DockPanel Margin="0,2,0,0">
        <Button DockPanel.Dock="Right" Content="Create key" Margin="8,0,0,0" Command="{Binding GenerateKeyCommand}" />
        <TextBox Text="{Binding KeyPath}" />
      </DockPanel>

      <TextBlock Text="3. Enroll it on the Mac" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="12"
                 Text="Paste this into Terminal on the Mac. It pins the key to blip-dispatch, so it can run the eight bridge tools and nothing else: no shell, no forwarding. The bridge tools must already be installed in ~/.blip/bin (blip-setup or bridge/mac/install.sh)." />
      <TextBox Text="{Binding MacCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace"
               FontSize="11" Margin="0,6,0,0" MinHeight="54" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="8">
        <Button Content="Copy command" Command="{Binding CopyMacCommandCommand}" />
        <Button Content="Test connection" Command="{Binding TestCommand}" />
        <Button Content="Forget host key" Command="{Binding ForgetHostKeyCommand}" ToolTip.Tip="Only after you replaced or reinstalled the Mac" />
      </StackPanel>
      <SelectableTextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <SelectableTextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.6">
        <Run Text="Pinned host key: " /><Run Text="{Binding HostKey}" />
      </SelectableTextBlock>

      <TextBlock Text="Options" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,6" />
      <CheckBox Content="Hide conversations iPhone filed as Spam" IsChecked="{Binding HideSpam}" />
      <CheckBox Content="Hide Unknown Senders" IsChecked="{Binding HideUnknown}" />
      <CheckBox Content="Prefer iMessage when a contact has used it in this thread" IsChecked="{Binding PreferIMessage}" />
      <CheckBox IsChecked="{Binding PushRead}">
        <TextBlock TextWrapping="Wrap" Text="Mark conversations read on the Mac when I open them (brings Messages to the front on the Mac)" />
      </CheckBox>
      <CheckBox IsChecked="{Binding Tapbacks}">
        <TextBlock TextWrapping="Wrap" Text="Tapbacks (drives Messages through Accessibility on the Mac; needs tapbacks enabled there too)" />
      </CheckBox>
      <CheckBox IsChecked="{Binding Replies}">
        <TextBlock TextWrapping="Wrap" Text="Threaded replies (same Accessibility requirement)" />
      </CheckBox>
      <CheckBox IsChecked="{Binding LocalCache}">
        <TextBlock TextWrapping="Wrap" Text="Open instantly: keep an encrypted copy of the conversation list and recent threads on this PC (only your Windows login can read it; turning this off deletes it)" />
      </CheckBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="8">
        <Button Content="Cancel" IsCancel="True" MinWidth="90" Click="OnCancel" />
        <Button Content="Save" IsDefault="True" MinWidth="90" Classes="accent" Click="OnSave" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
