<Window x:Class="Blip.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Blip.Windows.ViewModels"
        xmlns:local="clr-namespace:Blip.Windows"
        Title="Blip" Width="1100" Height="760" MinWidth="720" MinHeight="480"
        Icon="/Themes/blip.ico" AllowDrop="True">
  <Window.Resources>
    <local:PairConverter x:Key="Pair" />

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- avatar: photo when the Mac has one, else coloured initials -->
    <DataTemplate x:Key="Avatar" DataType="{x:Type vm:ConversationViewModel}">
      <Grid Width="40" Height="40">
        <Ellipse Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse Visibility="{Binding Avatar, Converter={StaticResource EmptyToCollapsed}}">
          <Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" /></Ellipse.Fill>
        </Ellipse>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ConversationRow" DataType="{x:Type vm:ConversationViewModel}">
      <Grid Margin="4,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="9" Height="9" Fill="{StaticResource BlipBlue}" VerticalAlignment="Center"
                 Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}" />
        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Margin="2,0,10,0" />
        <StackPanel Grid.Column="2">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Opacity="0.6" FontSize="12" Margin="6,0,0,0" />
            <TextBlock DockPanel.Dock="Right" Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11" Opacity="0.5"
                       Margin="4,2,0,0" Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" ToolTip="Pinned in Messages" />
            <TextBlock DockPanel.Dock="Right" Text="&#xE7ED;" FontFamily="{StaticResource IconFont}" FontSize="11" Opacity="0.5"
                       Margin="4,2,0,0" Visibility="{Binding Muted, Converter={StaticResource BoolToVis}}" ToolTip="Alerts hidden" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <TextBlock Text="{Binding Preview}" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" FontSize="13" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AttachmentTemplate" DataType="{x:Type vm:AttachmentViewModel}">
      <StackPanel Margin="0,2">
        <Button Command="{Binding OpenCommand}" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Name}">
          <Grid MinWidth="120" MinHeight="80">
            <TextBlock Text="{Binding Status}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Image Source="{Binding Image}" MaxWidth="320" MaxHeight="360" Stretch="Uniform" />
          </Grid>
        </Button>
        <Button Command="{Binding OpenCommand}" HorizontalAlignment="Left" Padding="10,6" Cursor="Hand"
                Visibility="{Binding IsChip, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0" />
            <TextBlock Text="{Binding Name}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Detail}" Opacity="0.6" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7"
                   Visibility="{Binding IsChip, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageViewModel}">
      <StackPanel Margin="12,2">
        <TextBlock Text="{Binding DayHeader}" HorizontalAlignment="Center" Opacity="0.55" FontSize="12" Margin="0,12,0,6"
                   Visibility="{Binding DayHeader, Converter={StaticResource EmptyToCollapsed}}" />
        <TextBlock Text="{Binding Sender}" Opacity="0.6" FontSize="12" Margin="14,4,0,1"
                   Visibility="{Binding ShowSender, Converter={StaticResource BoolToVis}}" />
        <StackPanel x:Name="Column" HorizontalAlignment="Left" MaxWidth="560">
          <Border x:Name="Bubble" CornerRadius="18" Padding="12,7" Background="{DynamicResource BubbleTheirs}"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                <MenuItem Header="Reply" Command="{Binding PlacementTarget.Tag.ReplyToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                          Visibility="{Binding PlacementTarget.Tag.RepliesEnabled, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                <MenuItem Header="Tapback" Visibility="{Binding PlacementTarget.Tag.TapbacksEnabled, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                  <MenuItem Header="❤️ Love" Command="{Binding PlacementTarget.Tag.ReactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Pair}"><Binding /><Binding Source="love" /></MultiBinding></MenuItem.CommandParameter>
                  </MenuItem>
                  <MenuItem Header="👍 Like" Command="{Binding PlacementTarget.Tag.ReactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Pair}"><Binding /><Binding Source="like" /></MultiBinding></MenuItem.CommandParameter>
                  </MenuItem>
                  <MenuItem Header="👎 Dislike" Command="{Binding PlacementTarget.Tag.ReactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Pair}"><Binding /><Binding Source="dislike" /></MultiBinding></MenuItem.CommandParameter>
                  </MenuItem>
                  <MenuItem Header="😂 Ha ha" Command="{Binding PlacementTarget.Tag.ReactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Pair}"><Binding /><Binding Source="laugh" /></MultiBinding></MenuItem.CommandParameter>
                  </MenuItem>
                  <MenuItem Header="‼️ Emphasize" Command="{Binding PlacementTarget.Tag.ReactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Pair}"><Binding /><Binding Source="emphasize" /></MultiBinding></MenuItem.CommandParameter>
                  </MenuItem>
                  <MenuItem Header="❓ Question" Command="{Binding PlacementTarget.Tag.ReactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Pair}"><Binding /><Binding Source="question" /></MultiBinding></MenuItem.CommandParameter>
                  </MenuItem>
                </MenuItem>
              </ContextMenu>
            </Border.ContextMenu>
            <StackPanel>
              <Border BorderThickness="3,0,0,0" BorderBrush="#80FFFFFF" Padding="8,2" Margin="0,2,0,6" Opacity="0.85"
                      Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="Quote" Text="{Binding ReplyQuote}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" />
              </Border>
              <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AttachmentTemplate}"
                            Visibility="{Binding Attachments, Converter={StaticResource EmptyToCollapsed}}" />
              <TextBox x:Name="Body" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                       Background="Transparent" Padding="0" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="unsent a message" FontStyle="Italic" Opacity="0.6"
                         Visibility="{Binding IsRetracted, Converter={StaticResource BoolToVis}}" />
              <TextBlock Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0" FontSize="12">
                <Hyperlink x:Name="Link" NavigateUri="{Binding LinkUrl}" RequestNavigate="OnLink"><Run Text="{Binding LinkTitle, Mode=OneWay}" /></Hyperlink>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border HorizontalAlignment="Right" CornerRadius="10" Padding="6,1" Margin="0,-6,4,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  Visibility="{Binding HasTapbacks, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Tapbacks}" FontSize="12" />
          </Border>
          <TextBlock x:Name="MetaLine" Text="{Binding Meta}" FontSize="11" Opacity="0.5" Margin="8,1" />
          <TextBlock Text="Sending…" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" Margin="8,0"
                     Visibility="{Binding Pending, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding Receipt}" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" Margin="8,0"
                     Visibility="{Binding HasReceipt, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding Failure}" FontSize="11" Foreground="#FF453A" HorizontalAlignment="Right" Margin="8,0" TextWrapping="Wrap"
                     Visibility="{Binding HasFailure, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMine}" Value="True">
          <Setter TargetName="Column" Property="HorizontalAlignment" Value="Right" />
          <Setter TargetName="MetaLine" Property="HorizontalAlignment" Value="Right" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="MineBlue">
          <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BlipBlue}" />
          <Setter TargetName="Body" Property="Foreground" Value="White" />
          <Setter TargetName="Quote" Property="Foreground" Value="White" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="MineGreen">
          <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BlipGreen}" />
          <Setter TargetName="Body" Property="Foreground" Value="White" />
          <Setter TargetName="Quote" Property="Foreground" Value="White" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Pending}" Value="True">
          <Setter TargetName="Bubble" Property="Opacity" Value="0.6" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330" MinWidth="240" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============ sidebar ============ -->
    <DockPanel Grid.Column="0">
      <DockPanel DockPanel.Dock="Top" Margin="12,10,8,4">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="New message" Click="OnNewMessage" />
          <Button Style="{StaticResource IconButton}" Content="&#xE8FB;" ToolTip="Mark all as read" Command="{Binding MarkAllReadCommand}" />
          <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}" />
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="OnSettings" />
        </StackPanel>
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="Orange" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Online"><Setter Property="Fill" Value="#30C759" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Offline"><Setter Property="Fill" Value="Gray" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NeedsAttention"><Setter Property="Fill" Value="#FF453A" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="Messages" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Opacity="0.6" FontSize="12" Margin="14,0,8,4" TextTrimming="CharacterEllipsis" />
      <DockPanel x:Name="NewMessagePanel" DockPanel.Dock="Top" Margin="10,2,10,6" Visibility="Collapsed">
        <Button DockPanel.Dock="Right" Content="Go" Margin="6,0,0,0" Command="{Binding StartNewConversationCommand}" Click="OnNewMessageGo" />
        <TextBox x:Name="NewRecipientBox" Text="{Binding NewRecipient, UpdateSourceTrigger=PropertyChanged}" ToolTip="Phone number or email"
                 KeyDown="OnNewRecipientKey" />
      </DockPanel>
      <Grid DockPanel.Dock="Top" Margin="10,2,10,8">
        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search conversations by name or number" />
        <TextBlock Text="Search conversations" Opacity="0.4" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Visibility="{Binding Filter, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
      </Grid>
      <ListBox ItemsSource="{Binding ConversationsView}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource ConversationRow}"
               HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

    <!-- ============ conversation ============ -->
    <DockPanel Grid.Column="2">
      <Border DockPanel.Dock="Top" Background="#33FF9F0A" Padding="12,8" Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissBannerCommand}" />
          <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              Visibility="{Binding Selected, Converter={StaticResource EmptyToCollapsed}}">
        <StackPanel Orientation="Horizontal" DataContext="{Binding Selected}">
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,10,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="600" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- composer -->
      <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12" Visibility="{Binding Selected, Converter={StaticResource EmptyToCollapsed}}">
        <TextBlock Text="This group is not sendable yet: the Mac has not listed its id." Opacity="0.7" Margin="4,0,0,6"
                   Visibility="{Binding CanCompose, Converter={StaticResource InvBoolToVis}}" />
        <DockPanel Margin="0,0,0,6" Visibility="{Binding HasReplyTarget, Converter={StaticResource BoolToVis}}">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CancelReplyCommand}" />
          <TextBlock Opacity="0.7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
            <Run Text="Replying to: " /><Run Text="{Binding ReplyTarget.Text, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding PendingFiles}" Margin="0,0,0,6">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="8" Padding="8,3" Margin="0,0,6,4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Converter={x:Static local:FileNameConverter.Instance}}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                  <Button Style="{StaticResource IconButton}" FontSize="10" Content="&#xE711;" CommandParameter="{Binding}"
                          Command="{Binding DataContext.RemovePendingFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel IsEnabled="{Binding CanCompose}">
          <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE723;" ToolTip="Attach a file" Click="OnAttach" VerticalAlignment="Bottom" />
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE724;" ToolTip="Send (Enter)"
                  Command="{Binding SendCommand}" VerticalAlignment="Bottom" Foreground="{StaticResource BlipBlue}" />
          <Grid>
            <TextBox x:Name="Composer" Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnComposerKey"
                     SpellCheck.IsEnabled="True" />
            <TextBlock Text="{Binding SendService}" Opacity="0.4" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding ComposerText, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" x:Name="Placeholder" />
          </Grid>
        </DockPanel>
      </StackPanel>

      <Grid>
        <TextBlock Text="Pick a conversation" Opacity="0.4" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Selected, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" x:Name="EmptyState" />
        <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2" Visibility="{Binding IsLoadingThread, Converter={StaticResource BoolToVis}}" />
        <ScrollViewer x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8">
          <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" />
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
