<Window x:Class="Blip.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blip settings" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/Themes/blip.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="860">
    <StackPanel Margin="20">
      <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.8" Visibility="Collapsed"
                 Text="Blip talks to the Mac that runs your iMessage bridge over SSH, with a key that can only run the bridge tools. Three steps: name the Mac, create the key, enroll it on the Mac." />

      <TextBlock Text="1. Your Mac" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,6" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="user@host (as you would ssh to it)" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,8,0" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Port" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>

      <TextBlock Text="2. Key" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6" />
      <TextBlock Text="Private key file (a dedicated ed25519 key, not your everyday one)" Opacity="0.7" FontSize="12" />
      <DockPanel Margin="0,2,0,0">
        <Button DockPanel.Dock="Right" Content="Create key" Margin="8,0,0,0" Command="{Binding GenerateKeyCommand}" />
        <TextBox Text="{Binding KeyPath, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>

      <TextBlock Text="3. Enroll it on the Mac" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="12"
                 Text="Paste this into Terminal on the Mac. It pins the key to blip-dispatch, so it can run the eight bridge tools and nothing else: no shell, no forwarding. The bridge tools must already be installed in ~/.blip/bin (blip-setup or bridge/mac/install.sh)." />
      <TextBox Text="{Binding MacCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
               FontSize="11" Margin="0,6,0,0" MinHeight="54" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <Button Content="Copy command" Command="{Binding CopyMacCommandCommand}" />
        <Button Content="Test connection" Margin="8,0,0,0" Command="{Binding TestCommand}" />
        <Button Content="Forget host key" Margin="8,0,0,0" Command="{Binding ForgetHostKeyCommand}" ToolTip="Only after you replaced or reinstalled the Mac" />
      </StackPanel>
      <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.6">
        <Run Text="Pinned host key: " /><Run Text="{Binding HostKey, Mode=OneWay}" />
      </TextBlock>

      <TextBlock Text="Options" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,6" />
      <CheckBox Content="Hide conversations iPhone filed as Spam" IsChecked="{Binding HideSpam}" />
      <CheckBox Content="Hide Unknown Senders" IsChecked="{Binding HideUnknown}" Margin="0,4,0,0" />
      <CheckBox Content="Prefer iMessage when a contact has used it in this thread" IsChecked="{Binding PreferIMessage}" Margin="0,4,0,0" />
      <CheckBox IsChecked="{Binding PushRead}" Margin="0,4,0,0">
        <TextBlock TextWrapping="Wrap" Text="Mark conversations read on the Mac when I open them (brings Messages to the front on the Mac)" />
      </CheckBox>
      <CheckBox IsChecked="{Binding Tapbacks}" Margin="0,4,0,0">
        <TextBlock TextWrapping="Wrap" Text="Tapbacks (drives Messages through Accessibility on the Mac; needs tapbacks enabled there too)" />
      </CheckBox>
      <CheckBox IsChecked="{Binding Replies}" Margin="0,4,0,0">
        <TextBlock TextWrapping="Wrap" Text="Threaded replies (same Accessibility requirement)" />
      </CheckBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        <Button Content="Save" IsDefault="True" MinWidth="90" Margin="8,0,0,0" Click="OnSave" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
