<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Blip.Windows.Views"
             x:Class="Blip.Windows.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Fluent's font for every control, popups and menus included. See Fonts.cs. -->
      <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Blip#Blip Inter</FontFamily>
      <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

      <!--
        Palette. Apple's Messages colours for bubbles and accents, Windows 11 layering for the
        chrome: the sidebar sits on the window backdrop (Mica when Windows offers it), the thread
        is a solid sheet over it. Every colour has a light and a dark value.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BlipBlue" Color="#007AFF" />
          <SolidColorBrush x:Key="BlipGreen" Color="#34C759" />
          <SolidColorBrush x:Key="BubbleTheirs" Color="#E9E9EB" />
          <SolidColorBrush x:Key="BubbleTheirsText" Color="#000000" />
          <SolidColorBrush x:Key="WindowSolid" Color="#EEEEF0" />
          <SolidColorBrush x:Key="WindowMicaTint" Color="#33F3F3F3" />
          <SolidColorBrush x:Key="Pane" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Hairline" Color="#14000000" />
          <SolidColorBrush x:Key="FieldStroke" Color="#24000000" />
          <SolidColorBrush x:Key="Field" Color="#0F000000" />
          <SolidColorBrush x:Key="RowHover" Color="#0D000000" />
          <SolidColorBrush x:Key="Chip" Color="#0F000000" />
          <SolidColorBrush x:Key="TextPrimary" Color="#E6000000" />
          <SolidColorBrush x:Key="TextSecondary" Color="#8A000000" />
          <SolidColorBrush x:Key="TextTertiary" Color="#5C000000" />
          <SolidColorBrush x:Key="Banner" Color="#26FF9F0A" />
          <SolidColorBrush x:Key="Card" Color="#FBFBFB" />
          <SolidColorBrush x:Key="CardStroke" Color="#0F000000" />
          <SolidColorBrush x:Key="CodeBack" Color="#08000000" />
          <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F6F6F6" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EFEFEF" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#29000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BlipBlue" Color="#0A84FF" />
          <SolidColorBrush x:Key="BlipGreen" Color="#30D158" />
          <SolidColorBrush x:Key="BubbleTheirs" Color="#3B3B3D" />
          <SolidColorBrush x:Key="BubbleTheirsText" Color="#FFFFFF" />
          <SolidColorBrush x:Key="WindowSolid" Color="#202022" />
          <SolidColorBrush x:Key="WindowMicaTint" Color="#26202020" />
          <SolidColorBrush x:Key="Pane" Color="#1C1C1E" />
          <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="FieldStroke" Color="#2BFFFFFF" />
          <SolidColorBrush x:Key="Field" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="RowHover" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="Chip" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="TextPrimary" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="TextSecondary" Color="#99FFFFFF" />
          <SolidColorBrush x:Key="TextTertiary" Color="#66FFFFFF" />
          <SolidColorBrush x:Key="Banner" Color="#33FF9F0A" />
          <SolidColorBrush x:Key="Card" Color="#2A2A2C" />
          <SolidColorBrush x:Key="CardStroke" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="CodeBack" Color="#33000000" />
          <SolidColorBrush x:Key="ButtonBackground" Color="#3A3A3C" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#444446" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#323234" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#21FFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#17FFFFFF" />
        </ResourceDictionary>
