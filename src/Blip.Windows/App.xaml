<Application x:Class="Blip.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Blip.Windows"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
      <local:HexToBrushConverter x:Key="HexToBrush" />
      <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
      <SolidColorBrush x:Key="BlipBlue" Color="#0A84FF" />
      <SolidColorBrush x:Key="BlipGreen" Color="#30C759" />
      <SolidColorBrush x:Key="BubbleTheirs" Color="#40808080" />
      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
</Application>
