<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 = Windows 10 2004+: needed for toast notifications. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the solution build (not run) on Linux/macOS CI too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Blip.Windows</RootNamespace>
    <AssemblyName>Blip</AssemblyName>
    <ApplicationIcon>Themes\blip.ico</ApplicationIcon>
    <!-- WPF Fluent ThemeMode is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blip.Core\Blip.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Themes\blip.ico" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
